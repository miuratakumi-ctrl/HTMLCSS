# ─────────────────────────────────────────────
# SEO Auto 設定ファイル
# ─────────────────────────────────────────────

# 認証JSONのパス（seo_auto/ からの相対パス）
CREDENTIALS_JSON=credentials/service_account.json

# GA4 プロパティID（例: properties/123456789）
GA4_PROPERTY_ID=properties/XXXXXXXXX

# GSC プロパティ（例: https://example.com/ または sc-domain:example.com）
GSC_PROPERTY=https://example.com/

# CTA クリックとして計測する GA4 イベント名
GA4_CTA_EVENT=cta_click

# 集計期間（日数）: 昨日から遡る日数
DAYS_BACK=28
